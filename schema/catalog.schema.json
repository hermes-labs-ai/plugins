{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-labs.ai/schemas/plugin-catalog-v1.json",
  "title": "Hermes Labs plugin distribution catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "description", "version", "owner", "namespaces"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "email", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "minLength": 3 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude", "codex", "copilot"],
          "properties": {
            "claude": { "const": "hermes-labs" },
            "codex": { "const": "hermes-labs" },
            "copilot": { "const": "hermes-labs-copilot" }
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "version", "category", "repository", "source", "targets", "capabilities", "compatibility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "category": { "enum": ["development", "developer-tools", "security", "productivity"] },
          "repository": { "type": "string", "pattern": "^https://github\\.com/hermes-labs-ai/[A-Za-z0-9_.-]+$" },
          "homepage": { "type": "string", "pattern": "^https://" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "ref", "commit"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["claude", "codex", "copilot"] }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["skill", "mcp", "hook", "command", "agent", "lsp"] }
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claude", "codex", "copilot"],
            "properties": {
              "claude": { "$ref": "#/$defs/compatibility" },
              "codex": { "$ref": "#/$defs/compatibility" },
              "copilot": { "$ref": "#/$defs/compatibility" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "compatibility": {
      "enum": ["verified", "listed-unverified", "unsupported"]
    }
  }
}
